# Copy into your local process environment, or set in Netlify Functions environment settings.
# Do not commit real passwords or secret values. This file is not loaded automatically.
ADMIN_USERNAME=admin
# Required: 8–128 characters. Set privately in Netlify.
ADMIN_PASSWORD=
# Required: at least 32 random characters. Set privately in Netlify.
SESSION_SECRET=

# Optional AI cartoons. Private server-side key with image-edit API access and billing.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
AI_DAILY_LIMIT=10
AI_SITE_DAILY_LIMIT=50
